# Drift Trading Bot Environment Variables
# Copy this file to .env and fill in your values

# Solana Wallet Configuration
SOLANA_PRIVATE_KEY=""  # Your wallet private key (Base58 encoded)
SOLANA_PUBLIC_KEY=""   # Your wallet public key

# Drift Configuration
DRIFT_ENVIRONMENT="devnet"  # or "mainnet"
DRIFT_SUBACCOUNT_ID=0

# RPC Configuration
SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_WS_URL="wss://api.devnet.solana.com"

# Trading Configuration
INITIAL_CAPITAL=1000.0
MAX_LEVERAGE=5
POSITION_SIZE_PCT=0.5

# Risk Management
MAX_DAILY_LOSS_PCT=0.05
EMERGENCY_STOP_LOSS_PCT=0.25

# Monitoring & Alerts
DISCORD_WEBHOOK_URL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# API Keys (if needed)
COINGECKO_API_KEY=""
BIRDEYE_API_KEY=""

# Development
DEBUG=True
LOG_LEVEL="INFO"